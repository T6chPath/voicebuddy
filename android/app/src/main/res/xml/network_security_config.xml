<?xml version="1.0" encoding="utf-8"?>
<!-- Your laptop's llama-server is plain http on the home network, so cleartext must be allowed.
     If you only use HTTPS servers, set cleartextTrafficPermitted="false". -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
