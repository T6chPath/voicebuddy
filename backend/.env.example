# Copy to .env and `export $(grep -v '^#' .env | xargs)` before starting uvicorn.
ZC_DATA_DIR=data
ZC_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ZC_COOKIE_SECURE=0                 # set 1 behind HTTPS (production)
ZC_ALLOW_REGISTRATION=1            # set 0 after creating your accounts
ZC_MAX_UPLOAD_MB=10
# Models: OpenAI-compatible servers. Keys are read from the env var named in api_key_env, never stored here.
ZC_MODELS=[{"id":"zenvqo-local","label":"zenvqo (local)","provider":"openai","base_url":"http://127.0.0.1:8080/v1","model":"local","description":"Fine-tuned zenvqo via llama-server"},{"id":"zenvqo-vision","label":"zenvqo vision","provider":"openai","base_url":"http://127.0.0.1:8081/v1","model":"qwen3-vl-2b","vision":true},{"id":"echo","label":"Demo (echo)","provider":"echo","description":"Offline demo"}]
# ZC_STATIC_DIR=../frontend/dist   # production: FastAPI serves the built frontend
