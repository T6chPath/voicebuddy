<resources>
    <!-- Royal sky: the app icon's bright blue, the mic's white and the crown's gold -->
    <style name="Theme.VoiceBuddy" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/accent</item>
        <item name="colorAccent">@color/accent</item>
        <item name="android:windowBackground">@drawable/bg_app</item>
        <item name="android:statusBarColor">#FF1257E0</item>
        <item name="android:navigationBarColor">#FF0A2E8A</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
    <style name="SectionLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">26dp</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:textColor">@color/muted</item>
        <item name="android:textSize">12sp</item>
    </style>
    <color name="bg">#FF0B3AA8</color>
    <color name="card">#FF1A55D6</color>
    <color name="card2">#FF2563E6</color>
    <color name="accent">#FFFFC233</color>
    <color name="marigold">#FFFFD24D</color>
    <color name="mint">#FF3DDC97</color>
    <color name="text">#FFFFFFFF</color>
    <color name="gold_dark">#FF3A2500</color>
    <color name="line">#33FFFFFF</color>
    <color name="muted">#FFC4DCFF</color>
</resources>
