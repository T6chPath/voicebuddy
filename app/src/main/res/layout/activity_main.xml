<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="VoiceBuddy"
        android:textColor="@color/text"
        android:textSize="28sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/statusText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:text="Mic dabao aur bolo"
        android:textColor="@color/muted"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/heardText"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="24dp"
        android:layout_weight="1"
        android:background="@color/card"
        android:gravity="center"
        android:padding="20dp"
        android:text="Try:\n\n“YouTube pe Kesariya chalao”\n“Papa ko message bhejo ki main aa raha hoon”\n“Papa ko WhatsApp video call karo”\n“Mummy ko call karo”\n“Open Instagram”"
        android:textColor="@color/text"
        android:textSize="16sp" />

    <ImageButton
        android:id="@+id/micButton"
        android:layout_width="96dp"
        android:layout_height="96dp"
        android:layout_marginTop="28dp"
        android:background="@drawable/mic_button"
        android:contentDescription="Speak"
        android:scaleType="centerInside"
        android:src="@drawable/ic_mic" />

    <TextView
        android:id="@+id/autoTapHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:gravity="center"
        android:padding="8dp"
        android:text="Turn on Auto-Tap (needed for auto-send and auto-play) — tap here"
        android:textColor="#FFB547"
        android:textSize="13sp" />
</LinearLayout>
