<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/drawer"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Home -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingTop="10dp"
        android:paddingEnd="12dp"
        android:paddingBottom="24dp">

        <!-- Header bar: (☰)  zenvqo.voice / greeting  (⚙) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginTop="4dp"
            android:layout_marginEnd="4dp"
            android:background="@drawable/header_bar"
            android:elevation="2dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingTop="8dp"
            android:paddingEnd="8dp"
            android:paddingBottom="8dp">

            <ImageButton
                android:id="@+id/menuButton"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:background="@drawable/round_button"
                android:contentDescription="Menu"
                android:foreground="?android:attr/selectableItemBackgroundBorderless"
                android:padding="12dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_menu"
                android:tint="@color/text" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/titleText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-black"
                    android:includeFontPadding="false"
                    android:letterSpacing="-0.01"
                    android:maxLines="1"
                    android:text="zenvqo.voice"
                    android:textColor="@color/text"
                    android:textSize="20sp"
                    android:ellipsize="end" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/greetingIcon"
                        android:layout_width="13dp"
                        android:layout_height="13dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_sun"
                        android:tint="@color/marigold" />

                    <TextView
                        android:id="@+id/greetingText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:fontFamily="sans-serif-medium"
                        android:includeFontPadding="false"
                        android:letterSpacing="0.03"
                        android:maxLines="1"
                        android:text="Namaste"
                        android:ellipsize="end"
                        android:singleLine="true"
                        android:textColor="@color/muted"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- ⚡ on/off switch, like YouTube's autoplay toggle: ON = everything finishes by itself -->
            <com.voicebuddy.app.AutoToggleView
                android:id="@+id/autoToggle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp" />

            <FrameLayout
                android:layout_width="46dp"
                android:layout_height="46dp">

                <ImageButton
                    android:id="@+id/settingsButton"
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:background="@drawable/round_button"
                    android:contentDescription="Settings"
                    android:foreground="?android:attr/selectableItemBackgroundBorderless"
                    android:padding="12dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_settings"
                    android:tint="@color/text" />

                <!-- unused dot (kept for layout) -->
                <View
                    android:id="@+id/settingsBadge"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:layout_gravity="top|end"
                    android:layout_marginTop="2dp"
                    android:layout_marginEnd="2dp"
                    android:background="@drawable/badge_dot"
                    android:elevation="3dp"
                    android:visibility="gone" />
            </FrameLayout>
        </LinearLayout>

        <!-- The mic, centred on the screen -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">

            <FrameLayout
                android:layout_width="300dp"
                android:layout_height="290dp">

                <View
                    android:id="@+id/glow"
                    android:layout_width="290dp"
                    android:layout_height="290dp"
                    android:layout_gravity="center"
                    android:background="@drawable/glow" />

                <View
                    android:id="@+id/ring1"
                    android:layout_width="200dp"
                    android:layout_height="200dp"
                    android:layout_gravity="center"
                    android:alpha="0"
                    android:background="@drawable/ring" />

                <View
                    android:id="@+id/ring2"
                    android:layout_width="200dp"
                    android:layout_height="200dp"
                    android:layout_gravity="center"
                    android:alpha="0"
                    android:background="@drawable/ring" />

                <View
                    android:id="@+id/ring3"
                    android:layout_width="200dp"
                    android:layout_height="200dp"
                    android:layout_gravity="center"
                    android:alpha="0"
                    android:background="@drawable/ring" />

                <ImageButton
                    android:id="@+id/micButton"
                    android:layout_width="270dp"
                    android:layout_height="226dp"
                    android:layout_gravity="center"
                    android:background="@null"
                    android:contentDescription="Bolne ke liye chidiya pe tap kijiye"
                    android:foreground="?android:attr/selectableItemBackgroundBorderless"
                    android:padding="0dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/home_bird" />
            </FrameLayout>

            <TextView
                android:id="@+id/statusText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:letterSpacing="0.02"
                android:text="Chidiya pe tap karo ya kahin bhi double-tap karo"
                android:textColor="@color/muted"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/heardText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:lineSpacingExtra="2dp"
                android:text="“Papa ko WhatsApp video call karo”"
                android:textColor="@color/text"
                android:textSize="22sp" />

            <LinearLayout
                android:id="@+id/replyRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="top"
                android:orientation="horizontal"
                android:visibility="gone">

                <ImageView
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/bird_avatar" />

                <TextView
                    android:id="@+id/replyText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:background="@drawable/reply_bubble"
                    android:paddingStart="14dp"
                    android:paddingTop="10dp"
                    android:paddingEnd="14dp"
                    android:paddingBottom="10dp"
                    android:textColor="@color/text"
                    android:textSize="15sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Sidebar -->
    <LinearLayout
        android:id="@+id/sidebar"
        android:layout_width="300dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@drawable/drawer_bg"
        android:clickable="true"
        android:orientation="vertical"
        android:paddingTop="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingEnd="20dp">

            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:importantForAccessibility="no"
                android:src="@drawable/bird_avatar" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:fontFamily="sans-serif-black"
                android:text="zenvqo.voice"
                android:textColor="@color/text"
                android:textSize="20sp" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="20dp"
            android:background="@color/line" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingTop="18dp"
            android:paddingEnd="12dp"
            android:paddingBottom="6dp">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_history"
                android:tint="@color/marigold" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:fontFamily="sans-serif-medium"
                android:text="Previous commands"
                android:textColor="@color/text"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/clearRecent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="?android:attr/selectableItemBackground"
                android:padding="8dp"
                android:text="Clear"
                android:textColor="@color/muted"
                android:textSize="13sp" />
        </LinearLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/recentList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="12dp"
                android:paddingTop="4dp"
                android:paddingEnd="12dp" />
        </ScrollView>

        <TextView
            android:id="@+id/recentEmpty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="12dp"
            android:text="Abhi koi command nahi. Mic dabake boliye — aapke commands yahan dikhenge, tap karke dobara chala sakte ho."
            android:textColor="@color/muted"
            android:textSize="13sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/line" />

        <LinearLayout
            android:id="@+id/drawerSettings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?android:attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingTop="16dp"
            android:paddingEnd="20dp"
            android:paddingBottom="20dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_settings"
                android:tint="@color/muted" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:text="Settings"
                android:textColor="@color/text"
                android:textSize="15sp" />
        </LinearLayout>
    </LinearLayout>
</androidx.drawerlayout.widget.DrawerLayout>
