<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="VoiceBuddy"
        android:textColor="@color/text"
        android:textSize="28sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/statusText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:text="Kahin bhi double-tap karo ya mic dabao, aur bolo"
        android:textColor="@color/muted"
        android:textSize="15sp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="20dp"
        android:layout_weight="1"
        android:background="@color/card">

        <TextView
            android:id="@+id/heardText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="4dp"
            android:padding="20dp"
            android:text="Try:\n\n• Torch on karo / Turn on light\n• Wi-Fi band karo · Bluetooth on karo · Mobile data on karo\n• Suraj ko message bhejo ki kal milte hain\n• Pradhuman ko email bhejo ki kal meeting hai\n• YouTube pe Kesariya chalao\n• ChatGPT se pucho Bharat ki rajdhani kya hai\n• Instagram pe search karo Virat Kohli\n• Papa ko SIM 2 se call karo\n• Papa ko WhatsApp video call karo\n• Inside any app: Like dabao · Type hello · Scroll down\n• Volume badhao · Screenshot lo · Phone lock karo\n\nSpelling galat ho to bhi chalega: chart gpt, watsapp, pradhaman…"
            android:textColor="@color/text"
            android:textSize="15sp" />
    </ScrollView>

    <ImageButton
        android:id="@+id/micButton"
        android:layout_width="96dp"
        android:layout_height="96dp"
        android:layout_marginTop="24dp"
        android:background="@drawable/mic_button"
        android:contentDescription="Speak"
        android:scaleType="centerInside"
        android:src="@drawable/ic_mic" />

    <TextView
        android:id="@+id/autoTapHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center"
        android:padding="8dp"
        android:text="Auto-Tap on karo (auto-send, auto-play, Wi-Fi/Bluetooth switch ke liye) — yahan tap karo"
        android:textColor="#FFB547"
        android:textSize="13sp" />
</LinearLayout>
